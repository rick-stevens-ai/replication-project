\[\begin{split}&\mathrm{e}^{\chi_{ij}}={\nu_{ij}^{*S}}\left[1- \mathpzc{z}_{ij}^{\prime}\cos 2\vec{q}_{1}\left(\vec{r}_{i}+\frac{\vec{r}_{ij}}{2}\right) \right]^{S};\\ & w_{ij}^{\prime}\equiv\frac{1}{2}-\left(\frac{1}{4}+\frac{\cos \bar{q}_{2}\vec{r}_{ij}}{4}\right)\cos\vec{q}_{1}\vec{r}_{ij};\\ & g_{ij}^{\prime}\equiv\left[\left(\frac{1}{4}-\frac{\cos\bar{q}_{ 2}\vec{r}_{ij}}{4}\right)\,\left/w_{ij}^{\prime}\right.\right],\end{split} \tag{122}\]

