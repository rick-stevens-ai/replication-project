        # The type of evolution in time the flow will have.
        # Available options are: CSV function | Constant | Pulsatile | Ramp.
        set Time evolution     = Pulsatile

        # The type of space distribution the flow velocity will have.
        # Available options are: Parabolic | Uniform.
        set Space distribution = Parabolic


        subsection CSV function
          # Name of the CSV file that value-over-time will be read from.
          set CSV file name  = 

          # Label of the time column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Time column    = time

          # Label of value column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Value column   = value

          # Delimiter of the CSV file.
          set Delimiter      = ,

          # Multiplicative scaling factor applied to the data.
          set Scaling factor = 1.0

          # The interpolation method used to interpolate the data. Beware that
          # for cubic spline interpolation, times are assumed to be
          # equispaced, and the contents of the time column in the CSV file
          # will only be used to determine initial and final time.
          # Available options are: Linear | Cubic spline | Fourier series.
          set Interpolation  = Linear
        end

        subsection Constant
          # Constant value for value [m3/s OR m/s].
          set Value = 0.0
        end

        subsection Pulsatile
          # Minimum value [m3/s OR m/s].
          set Minimum value = 0.0

          # Maximum value [m3/s OR m/s].
          set Maximum value = 1.0

          # Period of the value oscillations [s].
          set Period        = 1.0
        end

        subsection Ramp
          # Initial value of the value ramp [m3/s OR m/s].
          set Initial value = 0.0

          # Final value of the value ramp [m3/s OR m/s].
          set Final value   = 1.0

          # Time at which the value ramp starts [s].
          set Start time    = 0.0

          # Duration of the value ramp [s]; the ramp will have reached the
          # final value at start time plus load time.
          set Load time     = 0.1
        end

      end

      subsection Womersley
        subsection CSV function
          # Name of the CSV file that value-over-time will be read from.
          set CSV file name  = 

          # Label of the time column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Time column    = time

          # Label of value column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Value column   = value

          # Delimiter of the CSV file.
          set Delimiter      = ,

          # Multiplicative scaling factor applied to the data.
          set Scaling factor = 1.0

          # The interpolation method used to interpolate the data. Beware that
          # for cubic spline interpolation, times are assumed to be
          # equispaced, and the contents of the time column in the CSV file
          # will only be used to determine initial and final time.
          # Available options are: Linear | Cubic spline | Fourier series.
          set Interpolation  = Linear
        end

      end

      subsection Neumann
        # The type of evolution in time the pressure will have.
        # Available options are: CSV function | Constant | Pulsatile | Ramp.
        set Time evolution = Constant # default: Pulsatile


        subsection CSV function
          # Name of the CSV file that pressure-over-time will be read from.
          set CSV file name   = 

          # Label of the time column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Time column     = time

          # Label of pressure column in the CSV file. The first row of the CSV
          # file is interpreted as a header.
          set Pressure column = pressure

          # Delimiter of the CSV file.
          set Delimiter       = ,

          # Multiplicative scaling factor applied to the data.
          set Scaling factor  = 1.0

          # The interpolation method used to interpolate the data. Beware that
          # for cubic spline interpolation, times are assumed to be
          # equispaced, and the contents of the time column in the CSV file
          # will only be used to determine initial and final time.
          # Available options are: Linear | Cubic spline | Fourier series.
          set Interpolation   = Linear
        end

        subsection Constant
          # Constant value for pressure [Pa].
          set Value = 0.0
        end

        subsection Pulsatile
          # Minimum pressure [Pa].
          set Minimum value = 0.0

          # Maximum pressure [Pa].
          set Maximum value = 1.0

          # Period of the pressure oscillations [s].
          set Period        = 1.0
        end

        subsection Ramp
          # Initial value of the pressure ramp [Pa].
          set Initial value = 0.0

          # Final value of the pressure ramp [Pa].
          set Final value   = 1.0

          # Time at which the pressure ramp starts [s].
          set Start time    = 0.0

          # Duration of the pressure ramp [s]; the ramp will have reached the
          # final value at start time plus load time.
          set Load time     = 0.1
        end

      end

      subsection Resistance
        # The resistance constant [kg*s^{-1}*m^{-4}].
        set Resistance constant = 0.0


        subsection Base pressure
          # The type of evolution in time the pressure will have.
          # Available options are: CSV function | Constant | Pulsatile |
          # Ramp.
          set Time evolution = Constant


          subsection CSV function
            # Name of the CSV file that pressure-over-time will be read from.
            set CSV file name   = 

