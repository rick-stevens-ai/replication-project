clear
units metal
boundary p p p
box tilt large
atom_style full
read_data quartz.data
replicate 5 5 5
mass 1 28.0855
mass 2 15.9994
pair_style tersoff
pair_coeff * * Q-Tersoff.tersoff Si O
neighbor 2.0 nsq
neigh_modify delay 0 every 1 check yes
thermo 200
thermo_style custom step temp pe press density lx ly lz cellalpha cellbeta cellgamma
thermo_modify norm yes flush yes
timestep 0.001
velocity all create 298 12345 dist gaussian
fix 1 all npt temp 298 298 0.1 tri 1.0 1.0 1.0
run 20000
unfix 1
compute pe1 all pe/atom
compute pesum all reduce sum c_pe1
run 0
variable pea equal c_pesum/count(all)
print "FINAL_QT_NPT: density=$(density) lx=$(lx) ly=$(ly) lz=$(lz) pe_per_atom=${pea}"
write_data final.QT.npt.data nocoeff nofix
