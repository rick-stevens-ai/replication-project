\section*{Key equations (hand-transcribed from arXiv:1211.0762)}

% Eq.1 -- TI surface Dirac Hamiltonian (isotropic; NO hexagonal warping term).
\[
H_0 = \hbar v_f\,\big(\sigma_x k_y - \sigma_y k_x\big)
\tag{1}
\]

% Zeroth-order surface spin eigenstates (helical, spin-momentum locked).
% theta = atan2(k_y, k_x). Upper cone |+> left-handed, lower cone |-> right-handed.
\[
|\!\uparrow_\theta\rangle=\tfrac{1}{\sqrt2}\!\begin{pmatrix}+\,i\,e^{-i\theta}\\[2pt]1\end{pmatrix},\qquad
|\!\downarrow_\theta\rangle=\tfrac{1}{\sqrt2}\!\begin{pmatrix}-\,i\,e^{-i\theta}\\[2pt]1\end{pmatrix}
\tag{2--3}
\]

% Eqs.4-5 -- p-orbital-resolved surface wavefunctions to first order in k.
% Basis: {p_x,p_y,p_z} (x) {spin up,down}; p_r = radial, p_t = tangential orbital.
% Real fit parameters u0,v0,u1,v1,w1 (from ab-initio). Upper Dirac cone:
\[
|\Phi_+\rangle=(u_0-v_1 k)\,|p_z\rangle|\!\uparrow_\theta\rangle
-\tfrac{i}{\sqrt2}(v_0-u_1k-w_1k)\,|p_r\rangle|\!\uparrow_\theta\rangle
+\tfrac{1}{\sqrt2}(v_0-u_1k+w_1k)\,|p_t\rangle|\!\downarrow_\theta\rangle
\tag{4}
\]
% Lower Dirac cone:
\[
|\Phi_-\rangle=(u_0+v_1 k)\,|p_z\rangle|\!\downarrow_\theta\rangle
+\tfrac{i}{\sqrt2}(v_0+u_1k+w_1k)\,|p_r\rangle|\!\downarrow_\theta\rangle
-\tfrac{1}{\sqrt2}(v_0+u_1k-w_1k)\,|p_t\rangle|\!\uparrow_\theta\rangle
\tag{5}
\]

% Eq.6 -- spin-orbital projection tensor (orbital-resolved spin expectation).
\[
D^{\pm}_{i,\eta}(k,\theta)=\langle\Phi_\pm|\,\big(|p_i\rangle\langle p_i|\otimes s_\eta\big)\,|\Phi_\pm\rangle,
\quad i\in\{p_x,p_y,p_z\},\ \eta\in\{0,x,y,z\}
\tag{6}
\]

% p_z orbital spin texture (helical; left-handed upper / right-handed lower).
\[
\big[D^{\pm}_{p_z,x},\,D^{\pm}_{p_z,y},\,D^{\pm}_{p_z,z}\big]
=\pm\,(u_0\mp v_1 k)^2\,[\sin\theta,\,-\cos\theta,\,0]
\tag{$p_z$}
\]

% Eqs.7-8 -- p_x and p_y orbital spin textures (small-k limit).
\[
[D^{\pm}_{p_x,x},D^{\pm}_{p_x,y},D^{\pm}_{p_x,z}]=\mp\,\tfrac{v_0^2}{2}\,[\sin\theta,\cos\theta,0]
\tag{7}
\]
\[
[D^{\pm}_{p_y,x},D^{\pm}_{p_y,y},D^{\pm}_{p_y,z}]=\pm\,\tfrac{v_0^2}{2}\,[\sin\theta,\cos\theta,0]
\tag{8}
\]

% Orbital-character difference: 2-theta (pi-periodic) angular dependence.
\[
D^{\pm}_{p_x,0}-D^{\pm}_{p_y,0}=\mp\,2\cos(2\theta)\,(v_0\mp k u_1)\,k\,w_1
\tag{orb-diff}
\]

% Eq.9 -- p_x orbital polarization (ARPES-observable), definition.
\[
P_{p_x}=\frac{D_{p_x,0}(\theta=0)-D_{p_x,0}(\theta=\pi/2)}{D_{p_x,0}(\theta=0)+D_{p_x,0}(\theta=\pi/2)}
\tag{9}
\]

% Eq.10 -- closed form; sign flips across the Dirac point (tangential<->radial).
\[
P_{p_x}^{\pm}=\mp\,\frac{2\,(v_0\mp E u_1)\,(E w_1)}{(v_0\mp E u_1)^2+E^2 w_1^2}
\tag{10}
\]

