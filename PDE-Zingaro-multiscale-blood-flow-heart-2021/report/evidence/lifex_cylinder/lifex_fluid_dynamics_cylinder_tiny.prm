# Listing of Parameters
# ---------------------
subsection Fluid dynamics
  # Constant forcing term (e.g. gravity).
  set Forcing term = 0, 0, 0


  subsection Boundary conditions
    # Tags of boundaries where a no-slip condition is imposed.
    set No-slip tags   = 0

    # Tags of fixed boundaries where a free-slip condition is imposed.
    # Free-slip conditions on moving boundaries are currently not supported.
    set Free-slip tags = 


    subsection Inlet
      # Tags of the boundary.
      set Tags                       = 1

      # Dirichlet conditions impose a parabolic or flat velocity profile
      # (positive when inflow); Womersley impose a Womersley profile with a
      # prescribed flow rate (on circular boundaries); Neumann conditions a
      # uniform normal stress; Resistance conditions a uniform normal stress
      # that increases linearly with outgoing flowrate. Switching sets
      # conditions that change type over time, among the previous ones.
      # Available options are: Dirichlet | Womersley | Neumann | Resistance |
      # Switching.
      set Type of boundary condition = Dirichlet # default: Neumann

      # If true, the tangential component of velocity is constrained to zero
      # (only forNeumann and Resistance conditions).
      set Zero tangential velocity   = false


      subsection Dirichlet
        # The type of evolution in time the flow will have.
        # Available options are: CSV function | Constant | Pulsatile | Ramp.
        set Time evolution     = Pulsatile

        # The type of space distribution the flow velocity will have.
        # Available options are: Parabolic | Uniform.
        set Space distribution = Parabolic


        subsection Pulsatile
          # Minimum value [m3/s OR m/s].
          set Minimum value = 0.0

          # Maximum value [m3/s OR m/s].
          set Maximum value = 2.5e-4 # default: 1.0

          # Period of the value oscillations [s].
          set Period        = 0.8    # default: 1.0
        end

      end

    end

    subsection Outlet
      # Tags of the boundary.
      set Tags                       = 2

      # Dirichlet conditions impose a parabolic or flat velocity profile
      # (positive when inflow); Womersley impose a Womersley profile with a
      # prescribed flow rate (on circular boundaries); Neumann conditions a
      # uniform normal stress; Resistance conditions a uniform normal stress
      # that increases linearly with outgoing flowrate. Switching sets
      # conditions that change type over time, among the previous ones.
      # Available options are: Dirichlet | Womersley | Neumann | Resistance |
      # Switching.
      set Type of boundary condition = Neumann

      # If true, the tangential component of velocity is constrained to zero
      # (only forNeumann and Resistance conditions).
      set Zero tangential velocity   = false


      subsection Neumann
        # The type of evolution in time the pressure will have.
        # Available options are: CSV function | Constant | Pulsatile | Ramp.
        set Time evolution = Constant # default: Pulsatile


        subsection Constant
          # Constant value for pressure [Pa].
          set Value = 0.0
        end

      end

    end

  end

  subsection Initial conditions
    # Type of initial conditions. Zero starts from zero velocity, while File
    # reads the initial velocity from a VTU file. No initial conditions are
    # prescribed for pressure.
    # Available options are: Zero | File.
    set Type = Zero

  end

  subsection Mesh and space discretization
    # Available options are: File | Hypercube | Cylinder | Channel with
    # cylinder.
    set Mesh type                = Cylinder # default: File

    # Specify whether the input mesh has hexahedral or tetrahedral elements.
    # Tetrahedral meshes can only be imported from file.
    # Available options are: Hex | Tet.
    set Element type             = Hex

    # Number of global mesh refinement steps applied to the initial grid.
    # Ignored if restart is enabled.
    set Number of refinements    = 4        # default: 0

    # This option is only used if the Element type is Tet. In that case, the
    # mesh is only read by one process for every group of this size, and then
    # communicated to other processes in that group. A value of 0 indicates
    # that the group contains all processes (i.e. only one process reads the
    # mesh). Small groups are faster but may take up a lot of memory during
    # the mesh creation phase. Conversely, large groups require less memory
    # but the mesh creation may be slower.
    set Reading group size       = 1

    # Degree of the velocity FE space.
    set Velocity FE space degree = 1

    # Degree of the pressure FE space.
    set Pressure FE space degree = 1


    subsection Cylinder
      # Cylinder radius [m].
      set Radius           = 0.01

      # Cylinder length [m].
      set Length           = 0.1

      # Number of slices along the cylinder axis.
      set Number of slices = 5    # default: 3
    end

  end

  subsection Physical constants and models
    # Viscosity [Pa * s].
    set Viscosity                  = 3.5e-3

    # Density [kg * m^{-3}].
    set Density                    = 1.06e3

    # Treatment of the Navier-Stokes diffusive term.
    # Available options are: SymGrad-Grad | Grad-Grad | SymGrad-SymGrad.
    set Diffusion term formulation = SymGrad-Grad
  end


  subsection Backflow stabilization
    # Backflow stabilization method to be used.
    # Available options are: None | Inertial.
    set Type                                           = Inertial # default: None

    # Neumann boundary tags where the backflow stabilization must be applied.
    set Tags of backflow stabilized Neumann boundaries = 2    # default: 

    # Coefficient beta for the backflow stabilization
    set Beta                                           = 1.0
  end

  subsection Stabilization and turbulence models
    # Available options are: None | SUPG | PSPG | SUPG-PSPG.
    set Stabilization method                 = SUPG-PSPG

    # Available options are: None | VMS-LES.
    set Turbulence model                     = None

    # Available options are: Metric-tensors | Cell-diameter.
    set Stabilization parameters computation = Metric-tensors

    # Coefficient multiplying all stabilization terms
    set Constant factor                      = 1.0
  end

  subsection Resistive Immersed Implicit Surface
    # Toggle activation of the RIIS term.
    set Active                                      = true                       # default: false

    # Toggle use of surface velocity (if false, quasi-static approximation
    # u_Gamma=0).
    set Use surface velocity                        = false                      # default: true

    # Use unsigned distance, instead of signed one, when assembling the
    # smeared Dirac delta of the RIIS factor.
    set Use unsigned distance in assembly           = false

    # Labels used to identify the surfaces in the output (one for each
    # surface).
    set Surface labels                              = surface

    # Files basenames (no extension) for the immersed surfaces (one for each
    # surface).
    set Immersed surfaces basenames                 = data/cylinder_plane_closed # default: surface

    # Toggles movement of each immersed surface with the ALE displacement of
    # the fluid domain (one for each surface, or a single value applied to all
    # surfaces).
    set Move surfaces with ALE                      = true                       # default: false

    # Flip the normal vector for immersed surfaces.
    set Flip normals                                = false

    # For each surface, toggle on-off behavior.
    set On-off behavior                             = false

    # Name of the displacement fields stored in the immersed surface files
    # (one for each surface).
    set Displacement names                          = openingField               # default: dVecGamma0

    # For each immersed surface, the configuration of its input VTP file: Open
    # | Closed.
    set Input configurations                        = Closed                     # default: Open

    # Initial immersed surfaces configurations, for each surface: Open |
    # Closed.
    set Initial configurations                      = Closed                     # default: Open

    # The half-thickness of the smooth Dirac function, one for each RIIS term
    # [m] (one for each surface).
    set Epsilons                                    = 0.003                      # default: 0.001

    # The resistances of the RIIS terms [kg * m^{-1} * s^{-1}] (one for each
    # surface).
    set Resistances                                 = 1e4                        # default: 1000

    # Factor multiplying epsilon when the surface is in open configuration
    # (one for each surface).
    set Epsilons factors in open configuration      = 1.0

    # Factor multiplying epsilon when the surface is in closed configuration
    # (one for each surface).
    set Epsilons factors in closed configuration    = 1.0

    # Factor multiplying resistance when the surface is in open configuration
    # (one for each surface).
    set Resistances factors in open configuration   = 1.0

    # Factor multiplying resistance when the surface is in closed
    # configuration (one for each surface).
    set Resistances factors in closed configuration = 1.0

    # Factor multiplying the surface velocity u_Gamma in Navier-Stokes
    # momentum equation (one for each surface) [-].
    set Surface velocities factors                  = 1.0


    subsection Displacement law
      # Displacement law for immersed surface: Prescribed | Flow driven.
      set Displacement laws             = Prescribed

      # For the Prescribed and Flow driven displacement laws, shapes of the
      # opening and closing ramps (one for each surface). Linear | Cosine |
      # Exponential | CosineExponential
      set Ramp shapes                   = Cosine

      # Coefficient for Exponential and CosineExponential ramp shapes, for the
      # Prescribed and Flow driven displacement laws (one for each surface).
      set Ramp exponential coefficients = -3.0


      subsection Prescribed
        # Starting first ramp time (one for each surface) [s].
        set First ramp: start time  = 0.15 # default: 0.10

        # Ending first ramp time (one for each surface) [s].
        set First ramp: end time    = 0.25 # default: 0.11

        # Starting second ramp time (one for each surface) [s].
        set Second ramp: start time = 0.55 # default: 0.20

        # Ending second ramp time (one for each surface) [s].
        set Second ramp: end time   = 0.65 # default: 0.21
      end

      subsection Flow driven
        # Time required to go from closed to open configuration (one for each
        # surface) [s].
        set Duration of the opening ramp = 1e-3

        # Time required to go from open to closed configuration (one for each
        # surface) [s].
        set Duration of the closing ramp = 1e-3

        # Refractory time [s]. After the valve has opened (or closed), this
        # amount of time must pass before it can close (or open) again.
        set Refractory time              = 0

        # How the closing of the valve is triggered. Volume derivative means
        # that the valve is closed based on a condition on the flow rate.
        # Prescribed closes the valve at a specified time.
        # Available options are: Volume derivative | Pressure jump |
        # Prescribed.
        set Closing law                  = Volume derivative


        subsection Volume derivative closing
          # For each immersed surface, the volume compartment whose derivative
          # must be checked to trigger the closing of the valve.
          set Volume compartments              = 

          # For each immersed surface, the expected direction of the flow
          # through it, when in open configuration. When the derivative of the
          # associated volume compartment has opposite sign to the flow
          # direction specified here, the closing of the valve is triggered.
          set Flow direction through the valve = 
        end

        subsection Prescribed closing
          # Immersed surface closing: start time (one for each surface) [s]
          # (if immersed surface closing law is Prescribed).
          set Closing start times = 
        end

      end

    end

    subsection Control volumes
      # Labels of control volumes upwind to the surfaces (one for each
      # surface). These must have been defined in the Control volumes section
      # of Fluid dynamics parameters.
      set Upwind control volume labels   = 

      # Labels of control volumes downwind to the surfaces (one for each
      # surface). These must have been defined in the Control volumes section
      # of Fluid dynamics parameters.
      set Downwind control volume labels = 

      # Toggle the use of control volumes for computing upwind and downwind
      # pressures for immersed surfaces. If enabled, lists of upwind and
      # downwind control volumes must be provided, one for each surface. It is
      # required by the pressure jump displacement law.
      set Enable control volumes         = false
    end

  end

  subsection Arbitrary Lagrangian Eulerian
    # Toggle activation of the ALE formulation.
    set Active                                   = true  # default: false

    # Toggle import from a .vtp file. If false, a displacement Function should
    # be given in the code.
    set Import displacement from file            = true  # default: false


    subsection Input file
      # Polygonal surface filename with the definition of the displacements on
      # the boundary.
      # If empty, displacement must be implemented as a Function in the code.
      set Boundary displacements filename         = data/displacement_cylinder.vtp # default: 

      # Basename of the displacement fields on the boundary.
      # If Boundary displacements filename is empty, this param is neglected.
      set Boundary displacement field basename    = d                              # default: 

      # The geometry of the imported file is scaled by this factor.
      set Geometry scaling factor                 = 1

      # Imported displacement is scaled by this factor.
      set Displacement scaling factor             = 1

      # Number of figures to represent the time index used in the field name
      # (e.g. 2 in the case displacement00, displacement01, ...).
      set Number of figures for the index         = 4                              # default: 0

      # First index of the input time-dependent boundary displacement. (e.g.
      # 00 for "displacement00".
      set Initial index                           = 0

      # Number of time subintervals of the input time-dependent boundary
      # displacement.
      set Time subintervals                       = 8                              # default: 0

      # Stride between two consecutive time indices of a subinterval (e.g. 3
      # for displacement00, displacement03, displacement06, ...).
      set Time indices stride                     = 1

      # [s]. Time interval between two consecutive time instances of the input
      # time-dependent displacement, including stride (if, e.g., stride=2,
      # this is the total time between displacement00 and displacement02).
      set Time subinterval duration               = 0.1                            # default: 0

      # Available options are: Splines | Fourier | Derivative linear
      # interpolation | Derivative spline interpolation | Smoothing splines.
      set Interpolation mode                      = Splines

      # Only for splines mode. If true, impose zero derivative at both time
      # ends; if false, derivative is computed from data.
      set Zero spline ends derivative             = true

      # For smoothing splines interpolation, weight of the regularization on
      # second derivative. A value of 0 results in the interpolating cubic
      # spline, while as the value tends to infinity this tends to a
      # regression line.
      set Smoothing splines regularization weight = 1.0

      # If true, the time interpolation is periodic and the period can be set
      # in the time solver. If false, the time interpolation is performed in
      # the whole time domain, even if a periodic simulation is run (for
      # instance in terms of BCs).
      set Periodic interpolation                  = true
    end

    subsection Lifting
      # Differential model for the lifting.
      # Available options are: Harmonic | Linear elasticity.
      set Lifting operator           = Harmonic

      # Boundary tags for the portions of the boundary where to lift data
      # from.
      set Tags Dirichlet             = 0, 1, 2  # default: 

    end

    subsection Output
      # Enable/disable output.
      set Enable output                 = true

      # Name of the exported total displacement variable (not exported if
      # empty).
      set Displacement name             = displacement # default: 

      # Name of the exported ALE velocity variable (not exported if empty).
      set Velocity name                 = velocity_ale # default: 
    end

  end

  subsection Time solver
    # BDF order.
    set BDF order                = 1

    # Available options are: Implicit | Semi-implicit.
    set Non-linearity treatment  = Semi-implicit

    # Initial time [s].
    set Initial time             = 0

    # Final time [s].
    set Final time               = 7.5e-4           # default: 0.05

    # Time step [s].
    set Time step                = 2.5e-4        # default: 1e-2

    # Period [s].
    set Period                   = 1
  end

  subsection Non-linear solver
    # If true, the following parameters will be ignored: the max. number of
    # iterations will implicitly be set to 1 and tolerances to 0.
    set Linearized                   = true  # default: false
  end

  subsection Post-processing
    # Toggle exporting integral fluid properties to CSV: total kinetic energy,
    # total kinetic energy computed with fine-scale velocity (only if VMS-LES
    # model is active), and enstrophy.
    set Export fluid energies                          = false


    subsection Compute boundary flowrates
      # Tags of boundaries where to compute the outgoing flowrate.
      set Boundary tags   = 0, 1, 2             # default: 

      # Labels for the boundaries: used to name columns in output CSV file.
      set Boundary labels = wall, inlet, outlet # default: 
    end

    subsection Compute average boundary pressures
      # Tags of boundaries where to compute the average pressure.
      set Boundary tags   = 0, 1, 2             # default: 

      # Labels for the boundaries: used to name columns in output CSV file.
      set Boundary labels = wall, inlet, outlet # default: 
    end

  end

  subsection Output
    # Enable/disable output of HDF5 files.
    set Enable output                          = true

    # Basename for the output files. It will be suffixed with the timestep
    # index and the appropriate extension.
    set Output basename               = solution

    # Save results starting from a user-set time [s].
    set Start saving from time                 = 0

    # Save every n timesteps.
    set Save output every n timesteps          = 40                 # default: 1

    # Toogle exporting of CSV file.
    set Enable CSV output                      = true

    # Name for the CSV file.
    set CSV filename                           = fluid_dynamics.csv

    # CSV is written only once every n timesteps.
    set Print CSV every n timesteps            = 1


    subsection HDF5 format
      # For HDF5 output, this flag determines whether the mesh is saved in
      # every file or only in the first one. It is advisable to set this flag
      # to false if the mesh does not displace over time.
      set Export mesh at every output = true
    end
  end

end


