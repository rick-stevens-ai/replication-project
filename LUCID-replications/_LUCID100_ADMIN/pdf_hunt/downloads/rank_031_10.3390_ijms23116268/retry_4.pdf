<li id="B9-ijms-23-06268">
<span class="label">9.</span><cite>Liew H., Meister S., Mein S., Tessonnier T., Kopp B., Held T., Haberer T., Abdollahi A., Debus J., Dokic I., et al.  Combined DNA Damage Repair Interference and Ion Beam Therapy: Development, Benchmark, and Clinical Implications of a Mechanistic Biological Model. Int. J. Radiat. Oncol. 2021;112:802–817. doi: 10.1016/j.ijrobp.2021.09.048.</cite> [<a href="https://doi.org/10.1016/j.ijrobp.2021.09.048" class="usa-link usa-link--external" data-ga-action="click_feat_suppl" target="_blank" rel="noopener noreferrer">DOI</a>] [<a href="https://pubmed.ncbi.nlm.nih.gov/34710524/" class="usa-link">PubMed</a>] [<a href="https://scholar.google.com/scholar_lookup?journal=Int.%20J.%20Radiat.%20Oncol.&amp;title=Combined%20DNA%20Damage%20Repair%20Interference%20and%20Ion%20Beam%20Therapy:%20Development,%20Benchmark,%20and%20Clinical%20Implications%20of%20a%20Mechanistic%20Biological%20Model&amp;author=H.%20Liew&amp;author=S.%20Meister&amp;author=S.%20Mein&amp;author=T.%20Tessonnier&amp;author=B.%20Kopp&amp;volume=112&amp;publication_year=2021&amp;pages=802-817&amp;pmid=34710524&amp;doi=10.1016/j.ijrobp.2021.09.048&amp;" class="usa-link usa-link--external" data-ga-action="click_feat_suppl" target="_blank" rel="noopener noreferrer">Google Scholar</a>]</li>
