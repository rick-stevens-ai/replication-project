\section*{Key equations (hand-transcribed from arXiv:1911.13224)}

\textbf{(1) Luttinger j=3/2 normal-state Hamiltonian (4$\times$4):}
\[ H_0(\mathbf{k}) = c_0 k^2 + \sum_{i=1}^{5} c_i\, d_i(\mathbf{k})\, \gamma_i - \mu \tag{1}\]
in the four-component spinor basis $\psi \equiv (\psi_{3/2},\psi_{1/2},\psi_{-1/2},\psi_{-3/2})$.

\textbf{$l=2$ real spherical harmonics:}
\[ d_1=\tfrac{\sqrt3}{2}(k_x^2-k_y^2),\;\; d_2=\tfrac{1}{2}(3k_z^2-k^2),\;\; d_3=\sqrt3\,k_yk_z,\;\; d_4=\sqrt3\,k_zk_x,\;\; d_5=\sqrt3\,k_xk_y \]

\textbf{Anti-commuting Dirac matrices ($\{\gamma_i,\gamma_j\}=2\delta_{ij}$):}
\[ \gamma_1=\sigma_x\otimes I,\;\; \gamma_2=\sigma_z\otimes\sigma_z,\;\; \gamma_3=\sigma_z\otimes\sigma_y,\;\; \gamma_4=\sigma_z\otimes\sigma_x,\;\; \gamma_5=\sigma_y\otimes I \]

Cubic symmetry: $c_1=c_2\equiv c_{e_g}$, $c_3=c_4=c_5\equiv c_{t_{2g}}$, with $|c_{e_g}|>|c_{t_{2g}}|$.
PrBi parameter set (units $a/\pi$): $c_0=-6$, $c_{e_g}=-2$, $c_{t_{2g}}=-1$ eV, $\mu=-0.6$ eV.

\textbf{(2) Electron interaction:}
\[ H_I = g_0(\psi^\dagger\psi)^2 + \sum_a g_a(\psi^\dagger\gamma_a\psi)^2 \tag{2}\]

\textbf{(3) Fierz-rewritten s-wave + d-wave pairing channels:}
\[ H_s = g_s(\psi^\dagger\gamma_{45}\psi^*)(\psi^T\gamma_{45}\psi),\qquad
   H_{d_a} = g_{d_a}(\psi^\dagger\gamma_a\gamma_{45}\psi^*)(\psi^T\gamma_{45}\gamma_a\psi) \tag{3}\]
with $g_s=\tfrac14(g_0+\sum_a g_a)$, $g_{d_a}=\tfrac14(g_0+g_a-\sum_{b\neq a}g_b)$, $\gamma_{45}=i\gamma_4\gamma_5$.
Take $g_a=g_1$ so $g_{d_a}=\tfrac14(g_0-3g_1)$; assume attractive d-wave $g_{d_a}=-g$, neglect $H_s$.

\textbf{(4) Mean-field decomposition:}
\[ H_I = -g\sum_a\big[(\psi^\dagger\gamma_a\gamma_{45}\psi^*)\Delta_a + (\psi^T\gamma_{45}\gamma_a\psi)\Delta_a^*\big] \tag{4}\]

\textbf{(5) d-wave quintet (j=2) order parameters:}
\[ \Delta_a = \langle \psi_{-\mathbf{k}}^T\, \gamma_{45}\gamma_a\, \psi_{\mathbf{k}} \rangle,\quad a=1\dots5 \tag{5}\]
$\Delta_{e_g}\equiv(\Delta_1,\Delta_2)=(d_{x^2-y^2},d_{3z^2-r^2})$ (eg); $\Delta_{t_{2g}}\equiv(\Delta_3,\Delta_4,\Delta_5)=(d_{yz},d_{zx},d_{xy})$ (t2g).

\textbf{Ginzburg-Landau free energies (state selection):}
\[ F_{e_g} = r_{e_g}|\Delta_{e_g}|^2 + q_1|\Delta_{e_g}|^4 + q_2(\Delta_1\Delta_2^*-\Delta_2\Delta_1^*)^2 \]
\[ F_{t_{2g}} = r_{t_{2g}}|\Delta_{t_{2g}}|^2 + q_1'|\Delta_{t_{2g}}|^4 + q_2'|\Delta_{t_{2g}}\cdot\Delta_{t_{2g}}|^2
   + q_3'(|\Delta_3|^2|\Delta_4|^2+|\Delta_4|^2|\Delta_5|^2+|\Delta_5|^2|\Delta_3|^2) \]
One-loop: $r_{e_g}<r_{t_{2g}}$ for $|c_{e_g}|>|c_{t_{2g}}|$ (eg leads). Among eg candidates $(1,0),(0,1),(1,i)$,
the TR-breaking $(1,i)=d_{x^2-y^2}+i\,d_{3z^2-r^2}$ wins at weak coupling ($q_2>0$); band-flattening
drives the transition to the TR-symmetric real $d_{3z^2-r^2}$ $(0,1)$ at strong coupling.

\textbf{eg quadrupole Stevens operators (localized Pr moments):}
\[ O_{22}=\tfrac{\sqrt3}{2}(J_x^2-J_y^2),\qquad O_{20}=\tfrac12(3J_z^2-J^2) \]

\textbf{(7) Projected multipolar Kondo coupling ($j=3/2$):}
\[ \tilde H_K(\mathbf{k}) = \tilde J_K\Big[(\sqrt3\,O_{20}+O_{22})d_3(\mathbf{k})\gamma_3
   + (\sqrt3\,O_{20}-O_{22})d_4(\mathbf{k})\gamma_4 - 2O_{22}\,d_5(\mathbf{k})\gamma_5\Big] \tag{7}\]
with $\tilde J_K\equiv J_K(a/\pi)^2$. Ferro-quadrupolar $\langle O_{20}\rangle\neq0$ gives $c_3=c_4\neq c_5$
(Fermi-surface distortion): $c_\eta\equiv c_3=c_4=(-1-\tilde J_K\langle O_{20}\rangle)(a/\pi)^2$, $c_5=-1$.

\textbf{Headline BdG result (zero quadrupolar order):} weak coupling $\Rightarrow$ TR-breaking
$d_{x^2-y^2}+i\,d_{3z^2-r^2}$; 16 Bogoliubov pockets, each red/blue pocket Chern $\pm2$ (Class D + inversion, $2\mathbb{Z}$).

