\title{Quantum algorithms for abelian difference sets and applications to
       dihedral hidden subgroups}

\author{Martin Roetteler \\
        Microsoft Research, Quantum Architectures and Computation Group \\
        One Microsoft Way, Redmond, WA 98052, U.S.A. \\
        \texttt{martinro@microsoft.com}}

\date{August 9, 2016 \\ arXiv:1608.02005v1 [quant-ph]}

\begin{abstract}
Difference sets are basic combinatorial structures that have applications in
signal processing, coding theory, and cryptography. We consider the problem
of identifying a shifted version of the characteristic function of a (known)
difference set. We present a generic quantum algorithm that can be used to
tackle any hidden shift problem for any difference set in any abelian group.
Special cases include Paley difference sets (recovering the shifted Legendre
function algorithm), Hadamard difference sets (shifted bent functions), and
Singer difference sets on finite geometries (yielding new efficiently
solvable dihedral hidden subgroup instances).
\end{abstract}

\section{Introduction}

Hidden subgroup problems (HSP) and hidden shift problems underlie many
exponential quantum speedups (Shor factoring / discrete log $\Rightarrow$
abelian HSP; Kuperberg for dihedral HSP; van Dam--Hallgren--Ip for shifted
Legendre; etc.).

\section{Preliminaries}

\subsection{Fourier transforms over abelian groups}

For a finite abelian group $A$ the Pontryagin dual $\widehat{A}$ is
isomorphic to $A$.  The quantum Fourier transform $\mathrm{QFT}_A$ is the
unitary implementing the group DFT.

\subsection{Difference sets}

\begin{definition}[Difference set]
Let $A$ be a finite abelian group of order $v=|A|$.  A subset $D\subseteq A$
of size $k=|D|$ is a $(v,k,\lambda)$-difference set if for every
non-identity $g\in A$ the equation $g = d-d'$ with $d,d'\in D$ has exactly
$\lambda$ solutions.
\end{definition}

\begin{theorem}[Turyn, 1965]
For any non-trivial character $\chi$ of $A$,
$$
    |\chi(D)|^2 \;=\; k - \lambda.
$$
\end{theorem}

\subsection{Development / symmetric design}

\begin{theorem}
For a $(v,k,\lambda)$-difference set $D\subseteq A$, the incidence structure
$\mathrm{Dev}(D)=(A, \{D+g : g\in A\}, \in)$ is a symmetric $(v,k,\lambda)$
design.
\end{theorem}

\section{Quantum algorithm for shifted difference sets}

\begin{problem}[Shifted difference set problem]
Given $A$ abelian, a known $(v,k,\lambda)$-DS $D\subseteq A$, and a
membership oracle for $s+D$ (with $s\in A$ unknown), find $s$.
\end{problem}

\begin{algorithm}[Algorithm 1]
\begin{enumerate}
\item Prepare $\ket{0}\mapsto \frac{1}{\sqrt{|A|}}\sum_{g\in A}\ket{g}$.

\item Query the oracle to get
      $\frac{1}{\sqrt{|A|}}\sum_g (-1)^{[g\in s+D]}\ket{g}
       = \frac{1}{\sqrt{|A|}}\sum_g\ket{g}
         - \frac{2}{\sqrt{|A|}}\sum_{d\in s+D}\ket{d}$.

\item Apply $\mathrm{QFT}_A$:
      $\ket{\chi_0}
       - \frac{2}{|A|}\sum_{\chi}\chi(s+D)\ket{\chi}
       = \Bigl(1-\tfrac{2k}{|A|}\Bigr)\ket{\chi_0}
         - \frac{2}{|A|}\sum_{\chi\neq\chi_0}\chi(D)\chi(s)\ket{\chi}$.

\item Apply
      $\mathrm{diag}\bigl(1,\;\chi(D)/\sqrt{k-\lambda}:\chi\neq\chi_0\bigr)$
      to get
      $\bigl(1-\tfrac{2k}{|A|}\bigr)\ket{\chi_0}
       - \tfrac{2(k-\lambda)}{|A|}\sum_{\chi\neq\chi_0}\chi(s)\ket{\chi}$.

\item Apply $\mathrm{QFT}_A^{-1}$:
      $\frac{1}{\sqrt{|A|}}
        \Bigl(1-\tfrac{2(k-\sqrt{k-\lambda})}{|A|}\Bigr)\sum_g\ket{g}
       - \frac{2\sqrt{k-\lambda}}{\sqrt{|A|}}\ket{-s}$.

\item Measure in the standard basis:  outcome $-s$ with probability
      $p = 4(k-\lambda)/|A|$; every other element uniformly with
      probability $(1-p)/|A|$.
\end{enumerate}
\end{algorithm}

\subsection{Examples}

\subsubsection{Paley DS and shifted Legendre.}
$A = \mathbb{F}_q^+$, $q\equiv 3\pmod 4$; $D = \{\text{nonzero squares in }
\mathbb{F}_q\}$ is a $(q,(q-1)/2,(q-3)/4)$-DS.  Algorithm 1 then
specializes to van Dam--Hallgren--Ip.

\subsubsection{Hadamard DS and shifted bent functions.}
$A = \mathbb{Z}_2^{2n}$, $f:\mathbb{Z}_2^{2n}\to\mathbb{Z}_2$ bent, $D =
f^{-1}(1)$ is a $(2^{2n}, 2^{2n-1}-2^{n-1}, 2^{2n-2}-2^{n-1})$-DS.

\subsubsection{Singer DS on finite geometries.}
Singer DS in $\mathbb{Z}_v$ with $v=(q^{d+1}-1)/(q-1)$ tied to $PG(d,q)$.

\section{Application to dihedral HSP}

\begin{theorem}[Theorem 4]
For infinitely many $N$ (specifically Singer parameters), Algorithm 1 gives
an efficient quantum algorithm for the hidden shift problem over
$\mathbb{Z}_N$, hence for HSP over the dihedral group $D_N$, provided the
Step-4 diagonal operator can be implemented efficiently.
\end{theorem}

\begin{corollary}[Corollary 1]
For $N=2^n-1$ (Mersenne case), the van Dam--Seroussi construction gives an
efficient Step-4 implementation, so the shifted-DS / dihedral HSP is fully
polynomial-time on a quantum computer.
\end{corollary}

\section{Conclusion}

Unified framework for hidden shift problems associated with abelian
difference sets; subsumes shifted Legendre, shifted bent function; yields
new efficiently-solvable dihedral HSP instances via Singer DS.
