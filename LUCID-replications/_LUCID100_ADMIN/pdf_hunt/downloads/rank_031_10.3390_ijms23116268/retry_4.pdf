<td align="center" valign="middle" rowspan="1" colspan="1">DU145 </td>
<td align="center" valign="middle" rowspan="1" colspan="1">5.9 × 10<sup>−3</sup>
</td>
<td align="center" valign="middle" rowspan="1" colspan="1">0.17 </td>
