\[
H_{\rm BdG}(\mathbf R,\mathbf p) =
\begin{pmatrix}
 \hat h_{\rm proj}(\mathbf R,\mathbf p) & \Delta(\mathbf R)(-i\sigma_y)\\[2pt]
