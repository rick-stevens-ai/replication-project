FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Case 1: inlet velocity 0.225 m/s (ACH=10)
// Case 2: inlet velocity 0.45 m/s (ACH=20)
// Inlet is on x=0 face, so flow is in +x direction

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.225 0 0);    // Change to (0.45 0 0) for Case 2
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }
}

