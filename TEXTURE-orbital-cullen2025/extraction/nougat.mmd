% --- Eq. (1): full 6x6 Luttinger-Kohn-Bir-Pikus Hamiltonian (schematic) ---
\[
H_0 \;=\;
\begin{pmatrix}
P+Q & S & R & 0 & -\tfrac{1}{\sqrt2}S & -\sqrt2\,R \\
S^{*} & P-Q & 0 & R & -\sqrt2\,Q & \sqrt{\tfrac{3}{2}}\,S \\
R^{*} & 0 & P-Q & -S & \sqrt{\tfrac{3}{2}}\,S^{*} & \sqrt2\,Q \\
0 & R^{*} & -S^{*} & P+Q & -\sqrt2\,R^{*} & -\tfrac{1}{\sqrt2}S^{*} \\
-\tfrac{1}{\sqrt2}S^{*} & -\sqrt2\,Q & \sqrt{\tfrac{3}{2}}\,S & -\sqrt2\,R & P-\delta_{so} & 0 \\
-\sqrt2\,R^{*} & \sqrt{\tfrac{3}{2}}\,S^{*} & \sqrt2\,Q & -\tfrac{1}{\sqrt2}S & 0 & P-\delta_{so}
\end{pmatrix}
\tag{1}
\]
% basis {|3/2,3/2>,|3/2,1/2>,|3/2,-1/2>,|3/2,-3/2>,|1/2,1/2>,|1/2,-1/2>};
% P,Q,R,S are the usual quadratic-in-k Luttinger blocks; delta_so = split-off gap.
% For Ge/GaAs/InAs/InSb the upper 4x4 block suffices (large delta_so).

% --- Eq. (2): 4x4 spherical Luttinger Hamiltonian (THE MODEL WE REBUILD) ---
\[
H_0 \;=\; -\frac{\hbar^{2}}{2m_0}\Big[\,(\gamma_1 + \tfrac{5}{2}\bar\gamma)\,k^{2}
      \;-\; 2\bar\gamma\,(\mathbf{k}\cdot\mathbf{J})^{2}\,\Big],
\qquad \bar\gamma=\tfrac{1}{2}(\gamma_2+\gamma_3)
\tag{2}
\]
% J_i = spin-3/2 matrices; heavy holes J_z=+-3/2, light holes J_z=+-1/2.

% --- Eq. (3): Berry curvature of band m in the spherical Luttinger model ---
\[
\Omega^{m}_{i,\mathbf{k}} \;=\; -\,\frac{k_i}{k^{3}}\,\big(J_z\big)_{mm}
\tag{3}
\]
% Finite even under inversion symmetry; note-worthy k_i/k^3 monopole-like form.

% --- Equilibrium OAM (local circulation part), spherical approximation ---
\[
L^{m}_{i,\mathbf{k}} \;=\; \frac{3\hbar\bar\gamma\,k_i}{\;\;}\,\big(J_z\big)_{mm}
\quad\text{(local-circulation OAM, Eq.~(4) region)}
\tag{4}
\]
% OAM operator L = (m/2)(r x v - v x r); for holes m -> -m_0 (bare mass, negative).

% --- Eq. (6) region: orbital current with quantum corrections ---
