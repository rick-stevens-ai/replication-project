clear
units metal
boundary p p p
box tilt large
atom_style full
read_data quartz.data
replicate 5 5 5
mass 1 28.0855
mass 2 15.9994
pair_style tersoff
pair_coeff * * Q-Tersoff.tersoff Si O
neighbor 2.0 nsq
neigh_modify delay 0 every 1 check yes
thermo 500
thermo_style custom step pe press density lx ly lz cellalpha cellbeta cellgamma
thermo_modify norm yes flush yes
# aniso keeps orthorhombic-ish scaling but relaxes each axis
min_style cg
fix boxrelax all box/relax aniso 1.0 vmax 0.001
minimize 1e-12 1e-12 20000 40000
unfix boxrelax
min_style cg
minimize 1e-10 1e-12 20000 100000
compute peatom all pe/atom
compute pesum all reduce sum c_peatom
run 0
variable pea equal c_pesum/count(all)
print "FINAL_QT_ANISO: density=$(density) lx=$(lx) ly=$(ly) lz=$(lz) pe_per_atom=${pea}"
