\title{Teleportation Systems Towards a Quantum Internet}
\author{Valivarthi et al., 2020, arXiv:2007.11157v2}

\begin{abstract}
Using fiber-coupled devices---SNSPDs and off-the-shelf optics---we achieve
telecom-band (1536.5\,nm) teleportation of time-bin qubits with fidelities
$F \geq 90\%$, consistent with an analytical model including realistic
imperfections. Compatible with 22\,km of deployed single-mode fiber.
\end{abstract}

\section{Fidelity definition}
The paper defines the teleportation figure of merit as
\begin{equation}
F \;=\; \langle \psi | \rho | \psi \rangle,
\end{equation}
where $|\psi\rangle$ is the input Alice prepared and $\rho$ is Bob's
reconstructed density matrix after the classical corrections.

\section{Bell state and BSM}
Bob distributes one photon of
\begin{equation}
|\Phi^+\rangle_{AB} \;=\; \tfrac{1}{\sqrt{2}}\left(|00\rangle + |11\rangle\right)
\end{equation}
to Charlie, who Bell-projects onto
\begin{equation}
|\Psi^-\rangle_{AB} \;=\; \tfrac{1}{\sqrt{2}}\left(|el\rangle_{AB} - |le\rangle_{AB}\right).
\end{equation}

\section{Entangled-state fidelity model}
The paper reports an analytical prediction
\begin{equation}
F_{\rm ent} \;=\; \frac{3 V_{\rm ent} + 1}{4} \;=\; 97.3 \pm 0.2\%,
\end{equation}
where $V_{\rm ent}$ is the measured two-photon visibility.

\section{Headline teleportation numbers}
\begin{tabular}{lcc}
\hline
Configuration & $F_{\rm avg}$ (QST) & $F_{\rm avg}$ (decoy) \\ \hline
no added fiber   & $89 \pm 1\%$ & $\geq 89 \pm 2\%$ \\
$+22$\,km fiber  & $89 \pm 1\%$ & $\geq 88 \pm 3\%$ \\ \hline
\end{tabular}

\section{Analytical model consistency}
Deviation from unity attributed to (i) multiphoton events in the SPDC
sources, (ii) residual polarization distinguishability at the BSM, and
(iii) dephasing / loss in the fiber. The paper predicts near-unit fidelity
is reachable with brightness and detector improvements.
