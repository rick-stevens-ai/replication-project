loadModel(Modelica); getErrorString();
loadFile("/work/Buildings/package.mo"); getErrorString();

// Try a Fluid tutorial example (simpler than SimpleHouse)
loadString("model TestReadWeather
  Buildings.BoundaryConditions.WeatherData.ReaderTMY3 weaDat(
    filNam=Modelica.Utilities.Files.loadResource(\"modelica://Buildings/Resources/weatherdata/USA_IL_Chicago-OHare.Intl.AP.725300_TMY3.mos\"));
  Real TDryBul_C = weaDat.weaBus.TDryBul - 273.15;
  Real HGloHor = weaDat.weaBus.HGloHor;
end TestReadWeather;");
getErrorString();

simulate(TestReadWeather,
         startTime=0,
         stopTime=31536000,
         numberOfIntervals=8760,
         tolerance=1e-6,
         method="dassl",
         outputFormat="mat",
         fileNamePrefix="TestReadWeather_1y");
getErrorString();
