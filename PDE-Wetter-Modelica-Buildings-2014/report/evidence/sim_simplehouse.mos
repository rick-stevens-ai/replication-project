// Load MSL and Buildings library, simulate SimpleHouse example
loadModel(Modelica);
getErrorString();
loadFile("/work/Buildings/package.mo");
getErrorString();

// Print library version
getVersion(Buildings);

// Simulate SimpleHouse (default stopTime is 3153600 = 1yr; we'll do a shorter run first)
setCommandLineOptions("--newBackend");

simulate(Buildings.Examples.SimpleHouse,
         startTime=0,
         stopTime=604800,   // 1 week
         numberOfIntervals=1008, // 10-min steps
         tolerance=1e-6,
         method="dassl",
         outputFormat="mat",
         fileNamePrefix="SimpleHouse_1w");
getErrorString();
