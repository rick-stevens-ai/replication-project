<math id="mm223" overflow="linebreak"><mrow><mstyle mathvariant="bold"><mrow><mn mathvariant="bold">25</mn><mo> </mo><mstyle mathvariant="bold" mathsize="normal"><mi mathvariant="bold">k</mi><mi mathvariant="bold">e</mi><mi mathvariant="bold">V</mi></mstyle><mo mathvariant="bold">/</mo><mstyle mathvariant="bold" mathsize="normal"><mo mathvariant="bold-sans-serif">μ</mo><mi mathvariant="bold">m</mi></mstyle></mrow></mstyle></mrow></math>
