    function loadScriptDynamically(scriptUrl, callback) {
        var gads = document.createElement('script'),
            node = document.getElementsByTagName('script') [0];
        gads.async = true;
        gads.src = scriptUrl;
        if (callback) {
            gads.onload = callback;
        }
        node.parentNode.insertBefore(gads, node);
    }

	// PERICLES-20612
