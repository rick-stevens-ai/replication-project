\title{Chiral and Topological Orbital Magnetism of Spin Textures}
\author{F. R. Lux, F. Freimuth, S. Bl\"ugel, Y. Mokrousov (arXiv:1706.06068v1, 2017)}

\section*{Key equations (hand-transcribed from the PDF)}

Emergent (real-space Berry curvature) magnetic field — the SCALAR SPIN CHIRALITY:
\[
B_{\mathrm{eff}}^{z} = \frac{\hbar}{2e}\,\hat{n}\cdot\left(\frac{\partial \hat n}{\partial x}\times\frac{\partial \hat n}{\partial y}\right).
\tag{1}
\]

Gradient expansion of the out-of-plane orbital magnetization
$M_{\mathrm{om}}=M(\hat n)e_z$ of a locally FM system:
\[
M_{\mathrm{com}} = M_{i\alpha}(\hat n)\,(\partial_i n_\alpha)\,e_z, \tag{2}
\]
\[
M_{\mathrm{tom}} = M_{ij}^{\alpha\beta}(\hat n)\,(\partial_i n_\alpha)(\partial_j n_\beta)\,e_z,
\tag{3}
\]
with $\partial_i=\partial/\partial x_i$, greek $\alpha,\beta\in\{x,y,z\}$, latin $i,j\in\{x,y\}$.
COM (Eq. 2) is LINEAR in gradients of $\hat n$; TOM (Eq. 3) is SECOND ORDER.

Dyson equation (Wigner / phase-space formulation):
\[
\big(\epsilon - H(X,\pi) + i0^{+}\big)\star G^{R}(X,\pi) = \mathrm{id}. \tag{4}
\]

Orbital moment surface density from the grand potential $\Omega$:
\[
M(x) = -\partial_B\langle\Omega(x)\rangle. \tag{5}
\]
\[
\langle\Omega\rangle \sim -\frac{1}{\pi}\,\mathrm{Im}\!\int\!\frac{dp}{(2\pi\hbar)^2}\,
f(\epsilon)(\epsilon-\mu)\,\mathrm{tr}\,G^{R}(x,p). \tag{6}
\]

2D Rashba model used for the explicit evaluation:
\[
H(X,\pi) = \frac{\pi^2}{2m_e} + \alpha_R (\pi\times\sigma)_z + \Delta_{xc}\,\sigma\cdot\hat n(X).
\tag{7}
\]

Chiral orbital magnetization for a Néel spin spiral $\hat n=(\sin qx,0,\cos qx)$,
to $O(\alpha_R)$:
\[
M_{\mathrm{com}} = \frac{e q \alpha_R}{48\pi}\cos\theta\,
\operatorname{sgn}(\Delta_{xc})\left(1-3\frac{\mu^2}{\Delta_{xc}^2}\right)
\Theta(|\Delta_{xc}|-|\mu|), \qquad \theta=qx. \tag{8}
\]

Rotated ("ferromagnetic") Hamiltonian after SU(2) gauge rotation
$U^\dagger(\sigma\cdot\hat n)U=\sigma_z$:
\[
H\to H_0 = \frac{(\pi+eA(X))^2}{2m_e} + \Delta_{xc}\sigma_z, \tag{9}
\]
with $A = U^\dagger A_R U + A_{xc}$, $A_{xc}=-i\hbar\,U^\dagger\nabla U/e$.

Emergent field for the spiral (gauge-field picture):
\[
B_{\mathrm{eff}}^{z}\big|_{\mathrm{spiral}} = \frac{m\alpha_R q}{e}\operatorname{sgn}(\Delta_{xc})\cos\theta.
\tag{10}
\]

COM as coupling to the diamagnetic Landau–Peierls susceptibility
$\chi_{\mathrm{LP}}^{\uparrow+\downarrow}=-e^2/(12\pi m_e)$:
\[
M_{\mathrm{com}} = \tfrac{1}{2}\,\chi_{\mathrm{LP}}^{\uparrow+\downarrow}\,B_{\mathrm{eff}}^{z}\,\operatorname{sgn}(\Delta_{xc}).
\tag{11}
\]

\textbf{HEADLINE — Topological orbital magnetization at zero spin-orbit coupling}
($\alpha_R\to0$, so $A=A_{xc}$ and $B_{\mathrm{eff}}^z\to$ Eq. 1):
\[
\boxed{\;
M_{\mathrm{tom}} = \frac{1}{4}\,\chi_{\mathrm{LP}}^{\uparrow+\downarrow}\,B_{\mathrm{eff}}^{z}\,
\operatorname{sgn}(\Delta_{xc})\left(1-3\frac{\mu^2}{\Delta_{xc}^2}\right)\;}
\qquad |\mu|<|\Delta_{xc}|,\;\; 0\ \text{otherwise}. \tag{12}
\]
The $1/4$ prefactor (vs $1/2$ for COM, Eq. 11) and the linearity in
$B_{\mathrm{eff}}^z$ (= scalar spin chirality, Eq. 1) are the central claims.

