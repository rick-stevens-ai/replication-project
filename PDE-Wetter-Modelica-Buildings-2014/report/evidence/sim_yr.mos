loadModel(Modelica); getErrorString();
loadFile("/work/Buildings/package.mo"); getErrorString();

// Annual simulation - the paper documents Chicago TMY3-based annual runs
simulate(Buildings.Examples.SimpleHouse,
         startTime=0,
         stopTime=31536000,   // 1 year
         numberOfIntervals=8760, // hourly
         tolerance=1e-6,
         method="cvode",
         outputFormat="mat",
         fileNamePrefix="SimpleHouse_1y");
getErrorString();
