% --- Eq. (7): intrinsic proper spin Hall conductivity (general degenerate form) ---
\[
\sigma^{l}_{ij,\mathrm{SHE}} \;=\; -\frac{2e}{\hbar}\sum_{\mathbf{k}}\sum_{mnn'}
   f(\varepsilon_{m\mathbf{k}})\;
   \mathrm{Im}\big[\, \tilde R^{\,mn}_{i,\mathbf{k}}\, \check s^{\,nn'}_{l,\mathbf{k}}\, \tilde R^{\,n'm}_{j,\mathbf{k}} \,\big]
\tag{7}
\]
% check = band-diagonal + degenerate matrix elements only;
% tilde  = matrix elements between NON-degenerate states only.
