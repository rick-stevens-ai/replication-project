\section*{Key equations (hand-transcribed, minimal d-wave altermagnet)}
\[ H_\sigma(k)=\begin{pmatrix}\varepsilon_A(k)+\sigma m & f(k)\\ f^*(k) & \varepsilon_B(k)-\sigma m\end{pmatrix},\quad \sigma=\pm1 \tag{1}\]
\[ \varepsilon_A(k)=-2t_1\cos k_x-2t_2\cos k_y,\quad \varepsilon_B(k)=-2t_2\cos k_x-2t_1\cos k_y \tag{2}\]
\[ f(k)=-2t_{nn}\,[\cos(k_x/2)+\cos(k_y/2)] \tag{3}\]
\[ \delta(k)=\tfrac12[\varepsilon_A(k)-\varepsilon_B(k)]=(t_1-t_2)(\cos k_x-\cos k_y)\ \ \text{(}d_{x^2-y^2}\text{-wave)} \tag{4}\]
\[ \Delta(k)=E^{lo}_{\uparrow}(k)-E^{lo}_{\downarrow}(k)\ \propto\ \delta(k),\qquad \sum_k \Delta(k)=0,\ \ M_{net}=0 \tag{5}\]
\[ \Delta(k_x,k_y)=-\Delta(k_y,k_x)\ \ \text{(C4 antisymmetry)},\qquad \Delta=0\ \text{on}\ k_x=\pm k_y\ \text{(nodes)} \tag{6}\]

