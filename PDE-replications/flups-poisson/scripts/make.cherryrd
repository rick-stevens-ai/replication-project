#---------------------------------------------------------
# COMPILERS - Homebrew g++-15 wrapped by mpic++ for OpenMP
#---------------------------------------------------------
CXX = mpic++
CC  = mpicc

# OpenMP via gcc-15
CXXFLAGS := -O3 -g -DNDEBUG -std=c++17 -fopenmp
CCFLAGS  := -O3 -g -DNDEBUG -std=c99 -fopenmp
LDFLAGS  := -fopenmp -lstdc++ -lm

# Optional flags (HDF5 needs parallel MPI build; skipping)
OPTS :=

#---------------------------------------------------------
# DEPENDENCIES
#---------------------------------------------------------
H3LPR_DIR := /tmp/install/h3lpr
H3LPR_INC := $(H3LPR_DIR)/include
H3LPR_LIB := $(H3LPR_DIR)/lib
H3LPR_LIBNAME := -lh3lpr

FFTW_DIR := /usr/local/opt/fftw
FFTW_INC := $(FFTW_DIR)/include
FFTW_LIB := $(FFTW_DIR)/lib
FFTW_LIBNAME := -lfftw3_omp -lfftw3

HDF5_DIR := /usr/local/opt/hdf5
HDF5_INC := $(HDF5_DIR)/include
HDF5_LIB := $(HDF5_DIR)/lib
HDF5_LIBNAME := -lhdf5
