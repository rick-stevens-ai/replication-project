\title{Optimal Quantum Algorithm for Polynomial Interpolation}
\author{Andrew M. Childs, Wim van Dam, Shih-Han Hung, Igor E. Shparlinski}
\arxiv{1509.09271}

\section{Setup and oracle}

Let $q = p^r$ be a prime power and $\mathbb{F}_q$ the finite field of order $q$.
An unknown polynomial $f(X) = c_d X^d + \cdots + c_1 X + c_0 \in \mathbb{F}_q[X]$
is specified by its coefficient vector $c \in \mathbb{F}_q^{d+1}$.  The oracle acts
\[
    O_f : |x, y\rangle \mapsto |x, y + f(x)\rangle, \qquad x, y \in \mathbb{F}_q.
\]

The additive character $e : \mathbb{F}_q \to \mathbb{C}$ is
\[
    e(z) = \exp\!\left(\frac{2\pi i\,\mathrm{Tr}(z)}{p}\right),
\]
where $\mathrm{Tr}(z) = z + z^p + z^{p^2} + \cdots + z^{p^{r-1}}$ is the trace to $\mathbb{F}_p$.
For prime $q = p$ (the case in our replication), $\mathrm{Tr}(z) = z$ and $e(z) = e^{2\pi i z/p}$.

The Fourier transform over $\mathbb{F}_q$ is
\[
    \mathrm{QFT}_q\,|x\rangle = \frac{1}{\sqrt{q}} \sum_{y \in \mathbb{F}_q} e(xy)\,|y\rangle.
\]
Sandwiching a standard query between $\mathrm{QFT}_q^{-1}$ and $\mathrm{QFT}_q$ on the second
register yields the phase query
\[
    \tilde O_f : |x, y\rangle \mapsto e(y\,f(x))\,|x, y\rangle.
\]

\section{The k-query algorithm (Section 2.2 of paper)}

Define $Z : \mathbb{F}_q^k \times \mathbb{F}_q^k \to \mathbb{F}_q^{d+1}$ by
\[
    Z(x,y)_j := \sum_{i=1}^{k} y_i\,x_i^{j}, \qquad j \in \{0, 1, \ldots, d\}. \tag{7}
\]
Let $R_k := Z(\mathbb{F}_q^k \times \mathbb{F}_q^k) \subseteq \mathbb{F}_q^{d+1}$ be the range,
and let $T_k \subseteq \mathbb{F}_q^k \times \mathbb{F}_q^k$ be a set of representatives so that
$Z\big|_{T_k} : T_k \to R_k$ is a bijection.

The algorithm:
\begin{enumerate}
    \item Prepare uniform superposition over $T_k$:  $\frac{1}{\sqrt{|T_k|}} \sum_{(x,y)\in T_k} |x, y\rangle$.
    \item Apply $k$ parallel phase queries; state becomes
    \[
        \frac{1}{\sqrt{|T_k|}} \sum_{(x,y)\in T_k} e\!\left(\sum_i y_i f(x_i)\right) |x, y\rangle
      = \frac{1}{\sqrt{|T_k|}} \sum_{(x,y)\in T_k} e(c \cdot Z(x,y))\,|x, y\rangle.
    \]
    \item Compute $Z$ in place: $|x, y\rangle \mapsto |Z(x,y)\rangle$, yielding
    \[
        |\hat c_{R_k}\rangle := \frac{1}{\sqrt{|R_k|}} \sum_{z \in R_k} e(c \cdot z)\,|z\rangle. \tag{6}
    \]
    \item Apply the $(d+1)$-fold inverse QFT over $\mathbb{F}_q$ and measure in the computational basis.
    Outcome $c' \in \mathbb{F}_q^{d+1}$ appears with probability
    \[
        |\langle c' | \mathrm{QFT}^{-1}_q^{\otimes (d+1)} | \hat c_{R_k}\rangle|^2.
    \]
    The correct coefficient vector $c$ appears with probability exactly $|R_k|/q^{d+1}$.
\end{enumerate}

\section{Main quantitative claims}

\begin{theorem}[Theorem 1 of paper]
The maximum success probability of any $k$-query quantum algorithm for interpolating a
degree-$d$ polynomial over $\mathbb{F}_q$ is
\[
    P^\star_{k,q,d} = \frac{|R_k|}{q^{d+1}}.
\]
This is achieved by the algorithm above.
\end{theorem}

\begin{theorem}[Theorem 2 of paper]
For fixed positive integer $d$:
\begin{itemize}
  \item[(i)] If $d$ is odd and $k = (d+1)/2$, then $|R_k|/q^{d+1} = \frac{1}{k!}\bigl(1 - O(1/q)\bigr)$.
  \item[(ii)] If $d$ is even and $k = d/2 + 1$, then $|R_k|/q^{d+1} = 1 - O(1/q)$.
\end{itemize}
\end{theorem}

\begin{theorem}[Theorem 3 of paper]
Gate-efficient variant with gate complexity $\mathrm{poly}(\log q)$ per query for case (i),
and $k!\cdot\mathrm{poly}(\log q)$ overall for case (ii).
\end{theorem}

\section{Classical baseline (for comparison)}

Classical query complexity is exactly $d+1$: Lagrange interpolation
\[
    f(X) = \sum_{i=0}^{d} y_i \prod_{\substack{j=0 \\ j \ne i}}^{d} \frac{X - x_j}{x_i - x_j}
\]
gives $c$ exactly from any $d+1$ distinct-point evaluations.  Lower bound $d+1$ is tight
(Shamir secret-sharing security).

\section{Predicted vs.\ measured success probabilities used in this replication}

For prime $q \in \{7, 11, 13\}$ and $d \in \{2, 3\}$:

$d=2$ (even), $k_{\rm opt} = 2$:  predicted $1 - O(1/q)$; measured $0.9825, 0.9925, 0.9945$.
$d=3$ (odd),  $k_{\rm opt} = 2$:  predicted $\tfrac{1}{2}(1 - O(1/q))$; measured $0.333, 0.383, 0.399$.
$d=3$ (odd),  $k = 3$ (Boneh–Zhandry regime):  predicted $1 - O(1/q)$; measured $0.9975, 0.9993, 0.9996$.

All measurements exactly equal $|R_k|/q^{d+1}$ (computed by direct enumeration of $R_k$),
confirming both Theorem 1 (algorithm attains the optimum) and Theorem 2 (asymptotic scaling).

