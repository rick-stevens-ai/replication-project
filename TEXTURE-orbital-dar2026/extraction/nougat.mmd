\[
b_z(\mathbf r,\mathbf p) = \varrho_z (p_x^2 - p_y^2) + \varrho_z V_z(\mathbf r,\chi),\qquad
V_z(\mathbf r,\chi) = \tfrac14\,\phi'(r)^2 \cos(2\chi) ,
