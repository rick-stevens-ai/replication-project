      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Global Transcriptional Response of Escherichia coli Exposed In Situ to Different Low-Dose Ionizing Radiation Sources</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/msystems.00718-22</rdf:li>
        </rdf:Alt>
