\title{Atomic and inter-atomic orbital magnetization induced in SrTiO$_3$ by chiral phonons}
\author{Sergei Urazhdin --- arXiv:2408.08683v3}

\section*{Key equations (hand-transcribed from the PDF)}

Molecular-orbital (MO) basis: four O $p_z$ orbitals $p_n$ ($n=1..4$) coordinating a
Ti atom in the $xy$ plane, plus the two chiral Ti $d_\sigma$ orbitals
$d_\sigma = -(\sigma d_{xz} + i d_{yz})/\sqrt{2}$, $\sigma=\pm1$.

\paragraph{Nonbonding oxygen states (Eq.\,1).}
\[
\psi_{n1} = \tfrac12 \sum_n p_n , \qquad
\psi_{n2} = \tfrac12 \sum_n (-1)^n p_n ,
\qquad E_{n1,n2} = \pm 2 t_{\mathrm{O\text{-}O}} .
\tag{1}
\]
with $t_{\mathrm{O\text{-}O}}<0$ the nearest-neighbour O--O $p_z$--$p_z$ matrix element.

\paragraph{Bonding / antibonding (Ti--O hybridized) states (Eq.\,2).}
\[
\psi_{a\sigma,\,b\sigma} = \frac{\cos\theta_{a,b}}{2}\sum_n e^{\,i n\sigma\pi/2} p_n
+ \sin\theta_{a,b}\, d_\sigma .
\tag{2}
\]

\paragraph{Hybridized energies (Eq.\,3).}
\[
E_{a,b} = \frac{E_d}{2} \pm \sqrt{\frac{E_d^2}{4} + 2 t_{\mathrm{Ti\text{-}O}}^2},
\qquad
\theta_{a,b}=\tan^{-1}\!\frac{\sqrt{2}\,t_{\mathrm{Ti\text{-}O}}}{E_d - E_{a,b}},
\tag{3}
\]
with $t_{\mathrm{Ti\text{-}O}} = \langle d_\sigma | \hat H | p_4 \rangle < 0$.

\paragraph{Bandgap (Eq.\,4).}
\[
\Delta = \frac{E_d}{2} + \sqrt{\frac{E_d^2}{4} + 2 t_{\mathrm{Ti\text{-}O}}^2} + 2 t_{\mathrm{O\text{-}O}}
= E_a - E_{n2} .
\tag{4}
\]

\paragraph{Ferroelectric perturbation of hopping (Eqs.\,5--6).}
\[
\delta t_{n,\sigma} = Q\, e^{\,i\sigma n\pi/2}\big[a_l \cos\xi + i\sigma a_t \sin\xi\big],
\qquad \xi = \varphi - n\pi/2 ,
\tag{5}
\]
For a circularly polarized mode $\varphi = c\omega t$ (chirality $c=\pm1$):
\[
\delta t_{n,\sigma} = Q a_+ e^{\,i c\sigma\omega t} + (-1)^n Q a_- e^{-i c\sigma\omega t},
\qquad a_\pm = \frac{a_l \pm a_t}{2}.
\tag{6}
\]
Coupling matrix elements:
$V_{\sigma,n1} = 2\sin\theta_a\, Q a_+ e^{-i c\sigma\omega t}$ (to $\psi_{n1}$),
$V_{\sigma,n2} = 2\sin\theta_a\, Q a_- e^{+i c\sigma\omega t}$ (to $\psi_{n2}$).

\paragraph{Transition probability at pulse peak, $Q(t)=Q_0 e^{-|t|/\tau}$, $\tau\gg\hbar/\Delta$ (Eq.\,7).}
\[
p_\sigma(t{=}0) = -\frac{4\sin^2\theta_a\, Q_0^2 (a_+^2 - a_-^2)}{(\Delta - c\sigma\hbar\omega)^2 + \hbar^2/\tau^2}.
\tag{7}
\]

\paragraph{Transient ATOMIC orbital moment (Eq.\,8).}
\[
m_{z,a}(t{=}0) \approx \frac{32\,\mu_B\, c\,\hbar\omega\, \sin^2\theta_a\, Q_0^2 (a_+^2 - a_-^2)}{\Delta^3},
\qquad (a_+^2 - a_-^2) = a_l a_t .
\tag{8}
\]
with $m_z = -2\mu_B(p_+ - p_-)$ (factor 2 = spin doubling).

\paragraph{Residual (post-pulse) probability (Eq.\,9).}
\[
p_\sigma(t\to\infty) = \frac{16\hbar^2 \sin^2\theta_a\, Q_0^2 (a_+^2 - a_-^2)}{\tau^2 (\Delta - c\sigma\hbar\omega)^4}
\ \sim\ 6\times10^{-5}\times p_\sigma(0).
\tag{9}
\]

\paragraph{Koster--Slater force parameters (Eqs.\,10--11).}
\[
a_t = -\frac{t_{\mathrm{Ti\text{-}O}}}{r_{\mathrm{Ti\text{-}O}}} \approx 5.7\ \mathrm{eV/nm},
\qquad r_{\mathrm{Ti\text{-}O}} = 0.2\ \mathrm{nm},\ t_{\mathrm{Ti\text{-}O}} = -V_{pd\pi} = -1.14\ \mathrm{eV},
\tag{10}
\]
\[
a_l = \frac{d t_{\mathrm{Ti\text{-}O}}}{d r_{\mathrm{Ti\text{-}O}}} = \frac{7 a_t}{2} = 20.0\ \mathrm{eV/nm},
\qquad t_{\mathrm{Ti\text{-}O}}(r) \propto r^{-7/2}.
\tag{11}
\]
Hence $a_+ \approx 13$ eV/nm, $a_- \approx 7$ eV/nm.

\paragraph{First-order correction and pumped amplitude (Eqs.\,12--14).}
\[
\psi_{n1}^{(1)} = -\sum_\sigma \frac{e^{\,i(\Delta/\hbar - \sigma\omega)t}}{\Delta - \sigma\hbar\omega} V_{\sigma,n1}\, \psi_{a\sigma},
\tag{12}
\]
\[
c_n \approx -\frac{1}{2}\frac{2\sin\theta_a\, Q a_+ e^{i\Delta t}}{\Delta^2}
\big[(\Delta-\omega)e^{\,i(c\omega t - \pi n/2)} + (\Delta+\omega)e^{-i(c\omega t - \pi n/2)}\big].
\tag{14}
\]

\paragraph{Circulating inter-atomic current (Eq.\,15) and moments (Eqs.\,16--18).}
\[
\langle I_{n,n+1}\rangle = -\frac{2 e t_{\mathrm{O\text{-}O}}}{\hbar}\,\mathrm{Im}(c_n^* c_{n+1})
= -\frac{32\, e\, t_{\mathrm{O\text{-}O}} \sin^2\theta_a\, Q^2 a_+^2 \omega c}{\Delta^3},
\tag{15}
\]
\[
m_{z1} = -\frac{8 e a^2 t_{\mathrm{O\text{-}O}} \sin^2\theta_a\, Q^2 a_+^2 \omega c}{\Delta^3},
\qquad
m_{z2} = +\frac{8 e a^2 t_{\mathrm{O\text{-}O}} \sin^2\theta_a\, Q^2 a_-^2 \omega c}{\Delta^3},
\tag{16,17}
\]
\[
\mu_{z,ia} = \frac{32\,\mu_1\, c\,\hbar\omega\, \sin^2\theta_a\, Q_0^2 (a_+^2 - a_-^2)}{\Delta^3},
\qquad
\mu_1 = -\frac{e a^2 t_{\mathrm{O\text{-}O}}}{2\hbar} \approx 1.6\,\mu_B,
\tag{18}
\]
with $a = 0.39$ nm the STO lattice constant and $t_{\mathrm{O\text{-}O}} = -0.8$ eV.
Eq.\,(18) is identical in form to Eq.\,(8) but scaled by $\mu_1$ instead of $\mu_B$.

\paragraph{Parameter values (paper).}
$t_{\mathrm{Ti\text{-}O}}=-1.14$ eV, $t_{\mathrm{O\text{-}O}}=-0.8$ eV,
$r_{\mathrm{Ti\text{-}O}}=0.2$ nm, $a=0.39$ nm, $\Delta=3.2$ eV,
$\lambda_{\mathrm{SOC}}=17$ meV (negligible), $\hbar\omega\approx12.4$ meV
($f\approx3$ THz), $\hbar\omega/\Delta\approx0.004$, $Q_0\approx0.08$ nm.

