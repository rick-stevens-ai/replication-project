</td>
<td align="center" valign="middle" rowspan="1" colspan="1">9.8 × 10<sup>−3</sup>
</td>
<td align="center" valign="middle" rowspan="1" colspan="1">11.4</td>
<td align="center" valign="middle" rowspan="1" colspan="1">129.6</td>
<td align="center" valign="middle" rowspan="1" colspan="1">[<a href="#B27-ijms-23-06268" class="usa-link" aria-describedby="B27-ijms-23-06268">27</a>,<a href="#B28-ijms-23-06268" class="usa-link" aria-describedby="B28-ijms-23-06268">28</a>,<a href="#B29-ijms-23-06268" class="usa-link" aria-describedby="B29-ijms-23-06268">29</a>]</td>
</tr>
